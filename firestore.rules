/**
 * @fileoverview Firestore Security Rules for BM_EVAPORAÇÃO application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles.
 * Only authenticated users can read and write their own profile data.
 * Listing of all users is explicitly denied for privacy.
 *
 * Data Structure:
 * User profiles are stored under the `/users/{userId}` path, where `{userId}`
 * corresponds to the Firebase Authentication UID.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Only authenticated users can access their own data.
 * - Data validation is relaxed in prototyping mode to enable rapid schema iteration.
 *
 * Denormalization for Authorization:
 *  The `/users/{userId}` path inherently ties user documents to their
 *  Authentication UID, eliminating the need for denormalized `ownerId`
 *  fields within the documents. The `isOwner()` function leverages this
 *  path-based ownership.
 *
 * Structural Segregation:
 *  The application does not require public data or content, so no structural
 *  segregation (e.g., private vs. public collections) is needed.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces access control for user profiles.
     * @path /databases/{database}/documents/users/{userId}
     * @allow (create) - Authenticated user with UID 'MEC7gPjrhTcs0YNWjl2I3nByM462' can create their own profile.
     * @allow (get) - Authenticated user with UID 'MEC7gPjrhTcs0YNWjl2I3nByM462' can read their own profile.
     * @allow (update) - Authenticated user with UID 'MEC7gPjrhTcs0YNWjl2I3nByM462' can update their own profile.
     * @allow (delete) - Authenticated user with UID 'MEC7gPjrhTcs0YNWjl2I3nByM462' can delete their own profile.
     * @deny (create) - Authenticated user with UID 'OTHER_UID' cannot create a profile for 'MEC7gPjrhTcs0YNWjl2I3nByM462'.
     * @deny (get) - Unauthenticated user cannot read any user profile.
     * @deny (list) - No user can list all profiles.
     * @principle Enforces document ownership for reads and writes.
     */
    match /users/{userId} {
      // Helpers
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      // Read Permissions
      allow get: if isOwner(userId);
      allow list: if false; // Listing all users is not permitted.

      // Write Permissions
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
  }
}